{
  "name": "business-operations",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "test": "turbo test --parallel",
    "start:dashboard": "turbo start --filter=@business-operations/dashboard",
    "start:website": "turbo start --filter=@business-operations/website",
    "dev:api": "turbo dev --filter=@business-operations/api",
    "dev:dashboard": "turbo dev --filter=@business-operations/dashboard",
    "build:dashboard": "turbo build --filter=@business-operations/dashboard",
    "dev:website": "turbo dev --filter=@business-operations/website ",
    "dev:desktop": "turbo dev --filter=@business-operations/desktop",
    "cli": "bun run packages/cli/bin/business-operations.ts",
    "jobs:dashboard": "turbo jobs --filter=@business-operations/jobs",
    "format": "biome format --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "lint:ci": "biome lint apps packages scripts",
    "test:ci": "bun test --exit --timeout 30000 packages scripts/local apps/worker/src apps/dashboard/src apps/api/src/chat && bun run --cwd apps/api test",
    "build:ci": "bun run --cwd packages/workbench build && bun run --cwd packages/mcp-apps build && bun run --cwd packages/cli build && bun run --cwd apps/desktop build && bun run --cwd apps/website build && bun run --cwd apps/dashboard build"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@date-fns/tz": "^1.4.1",
    "@fast-csv/format": "5.0.5",
    "@react-pdf/renderer": "^4.3.2",
    "@sindresorhus/slugify": "^3.0.0",
    "bullmq": "^5.71.1",
    "camelcase-keys": "^10.0.2",
    "change-case": "^5.4.4",
    "date-fns": "^4.1.0",
    "heic-convert": "1.2.4",
    "hono": "4.12.9",
    "jose": "^6.2.2",
    "nanoid": "^5.1.7",
    "node-xlsx": "^0.24.0",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "typescript": "^6.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@depot/cli",
    "core-js",
    "protobufjs"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "turbo": "2.9.3",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "toolpick": "^0.4.0",
    "use-stick-to-bottom": "^1.1.3"
  }
}
